# RL Observatory — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and modify as needed.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── OTel Collector Endpoint ──────────────────────────────────────────────────
# The gRPC endpoint where SigNoz's OTel Collector is listening.
OTEL_EXPORTER_ENDPOINT=127.0.0.1:4317

# Set to "true" for local development (no TLS).
OTEL_EXPORTER_INSECURE=true

# ── OTel Resource Attributes ─────────────────────────────────────────────────
OTEL_SERVICE_NAME=unity-3dball-agent
OTEL_DEPLOYMENT_ENVIRONMENT=local

# ── Unity ML-Agents Connection ───────────────────────────────────────────────
# The gRPC port Unity Editor listens on (default: 5004).
UNITY_BASE_PORT=5004

# Worker ID — must be unique if running multiple agents.
UNITY_WORKER_ID=0

# ── Metrics Export ───────────────────────────────────────────────────────────
# How frequently (ms) the PeriodicExportingMetricReader flushes to the collector.
METRICS_EXPORT_INTERVAL_MS=5000

# ── Simulation ───────────────────────────────────────────────────────────────
# Frame-rate governor sleep (seconds). Lower = faster but more CPU usage.
STEP_DELAY_SECONDS=0.02
